# =================================================================
# ElectroNova Backend Environment Configuration Template
# =================================================================

# Server & Database Configuration
PORT=8000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ElectroNova?retryWrites=true&w=majority

# Web Client Origin
FRONTEND_URL=http://localhost:3000

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Media Assets (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Domain Email / SMTP Configuration
# Option A: Custom Domain SMTP (Google Workspace, Zoho, Amazon SES, SendGrid)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=support@electronova.tech
EMAIL_PASS=your_app_password
EMAIL_FROM="ElectroNova Support" <support@electronova.tech>

# Option B: Standard Gmail App Password (Leave SMTP_HOST blank to use Gmail service)
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx
